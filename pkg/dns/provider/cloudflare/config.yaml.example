# Example Cloudflare account entry for ~/.zonekit.yaml (or configs/config.example.yaml).
#
# This provider is NOT the generic OpenAPI/REST adapter described in
# pkg/dns/provider/README.md - it is a typed Go provider
# (pkg/dns/provider/cloudflare) registered under the name "cloudflare",
# built from these account fields via cloudflare.NewFromAccount /
# cloudflare.FromAccount. openapi.yaml in this directory is kept only as
# API-shape reference documentation and is not used to build this
# provider.
#
# Add one with: zonekit account add cloudflare --provider cloudflare

accounts:
  cloudflare:
    provider: "cloudflare"

    # Cloudflare API token (Bearer auth). Create one at
    # https://dash.cloudflare.com/profile/api-tokens with Zone.DNS edit
    # permission (and Zone.Zone Settings / SSL, bot management,
    # security.txt, rulesets edit if you use the zone-configuration
    # capability).
    api_token: "${CLOUDFLARE_API_TOKEN}"

    # Cloudflare account ID. Required unless token_scope is "user" -
    # account-owned tokens (the common case) verify against
    # /accounts/{account_id}/tokens/verify and some endpoints are
    # account-scoped.
    account_id: "${CLOUDFLARE_ACCOUNT_ID}"

    # "account" (default) or "user". See pkg/config/config.go's
    # TokenScope* constants.
    token_scope: "account"

    description: "Cloudflare account"
